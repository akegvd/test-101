{
  "name": "test-101",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:lesson": "node scripts/test-lesson.mjs",
    "test:solution": "vitest run /solution/",
    "coverage": "vitest run --coverage",
    "coverage:capstone": "vitest run lessons/12-capstone/exercise --coverage --coverage.include=src/utils/calcSellAmount.ts --coverage.include=src/components/SellFundForm.tsx",
    "test:mutation": "stryker run",
    "test:mutation:exercise": "stryker run stryker.exercise.config.json",
    "test:mutation:capstone": "stryker run stryker.capstone.config.json",
    "lint": "eslint . && tsc --noEmit",
    "demo:rename": "node scripts/demo-rename.mjs apply",
    "demo:revert": "node scripts/demo-rename.mjs revert",
    "bug:plant": "node scripts/bug-hunt.mjs plant",
    "bug:reveal": "node scripts/bug-hunt.mjs reveal"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "4.1.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-testing-library": "^7.16.2",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
